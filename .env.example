# Copy to .env and fill in. Never commit .env — this repository is public.
# Every variable here is parsed through a zod schema at boot; the process
# refuses to start if one is missing or malformed.

NODE_ENV=development

# --- Database (Neon) ---
DATABASE_URL=postgresql://user:password@host.neon.tech/traiv?sslmode=require

# --- API ---
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Unset in development so the session cookie stays host-only on localhost.
COOKIE_DOMAIN=
SESSION_SECRET=

# --- Dev only ---
# Shows a user-picker that bypasses auth. Guarded twice: this flag AND
# NODE_ENV !== production. The API hard-crashes at boot if both are ever true.
AUTH_DEV_BYPASS=false

# --- OTP delivery (ADR 0034) ---
# Primary channel. One line to switch. console is rejected in production.
OTP_TRANSPORT=email
# Used only when the primary send fails. none disables it.
OTP_FALLBACK=none

# --- Resend (ADR 0034) ---
# A verified sending domain (resend.com/domains) is required before this can reach a
# real inbox. Blank in development — the console transport prints OTPs to stdout instead.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# --- AWS SES (ADR: architecture.md) ---
# Blank in development — ConsoleMailer prints to stdout instead.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_ADDRESS=

# --- Google sign-in ---
# Optional. The button is hidden unless both the id and the secret are present.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# --- Razorpay ---
# Not read by anything yet — payments are unbuilt. Here so the names are decided.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- The Next apps (build-time; anything NEXT_PUBLIC_ is visible in the browser) ---
# Every app reads this. In production it is the public origin of the API, not localhost.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Where the client PWA runs — the join QR and link point here. Trainer app only.
NEXT_PUBLIC_CLIENT_URL=http://localhost:3001
# Marketing site only. Drives metadataBase, every canonical tag, sitemap.xml and
# robots.txt. Leave unset on Vercel and it uses VERCEL_PROJECT_PRODUCTION_URL; set it
# once you have the real domain so previews never claim to be it.
NEXT_PUBLIC_SITE_URL=http://localhost:3004

# Local Postgres for the test suite. Tests DELETE rows, and the remote database is
# ~300ms per query from India, so point them somewhere local:
#   createdb traiv_test
#   DATABASE_URL=postgresql://<you>@127.0.0.1:5432/traiv_test pnpm --filter @traiv/db db:migrate
TEST_DATABASE_URL=postgresql://<you>@127.0.0.1:5432/traiv_test

# The client app origin. Allowed through CORS alongside WEB_ORIGIN.
CLIENT_ORIGIN=http://localhost:3001

# Keys the OTP HMAC, separate from SESSION_SECRET so one leak is not both.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
OTP_PEPPER=

# YES in production, always. NO skips code verification entirely — anyone who knows an
# address could sign in as that person — so the API refuses to boot with NO in production.
OTP=YES

# The single platform administrator, by email address (ADR 0034). No endpoint grants
# this role; changing it and restarting is the only way to move it. Unset means nobody
# is admin.
ADMIN_EMAIL=
ENDORSE_ORIGIN=http://localhost:3002
ADMIN_ORIGIN=http://localhost:3003

# The public marketing site. Allowed through CORS for three routes that carry no session
# at all — the launch-list form, the analytics beacon and the blog.
MARKETING_ORIGIN=http://localhost:3004
# Same origin, exposed to the browser — the trainer/client apps link to the marketing
# site's public Terms/Privacy pages rather than duplicating that content.
NEXT_PUBLIC_MARKETING_URL=http://localhost:3004

# Optional server-only nutrition-label transcription. Never expose this key via NEXT_PUBLIC_*.
FOOD_LABEL_API_KEY=
FOOD_LABEL_MODEL=gpt-4.1-mini

# Native client: deployed HTTPS Next.js origin. Use a LAN URL for device development.
TRAIV_NATIVE_URL=http://localhost:3001
# Web/PWA push: generate once with `pnpm --filter @traiv/api exec tsx src/setup-push.ts`.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:replace-with-your-support-address@example.com
# iOS APNs (.p8 contents, with literal \n for newlines), Apple team, key and bundle identifiers.
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=app.traiv.client
APNS_SANDBOX=true
# Android FCM service account. Also add google-services.json to apps/client/android/app/.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Exercise catalog provider; keep keys server-only.
EXERCISE_CATALOG=legacy
EXERCISEAPI_KEY=
