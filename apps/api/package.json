{
  "name": "@traiv/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "retention": "tsx src/features/auth/retention.ts",
    "seed": "tsx src/seed.ts",
    "seed:library": "tsx src/library/seed.ts",
    "seed:exercises": "tsx src/library/exercise-db.ts",
